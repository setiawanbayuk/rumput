{
  "openapi": "3.0.3",
  "info": {
    "title": "E-SUKET Surat API",
    "version": "1.0.0",
    "description": "Kontrak endpoint SuratApiController. Semua endpoint memakai token Laravel Sanctum. Data surat difilter sesuai logika controller; endpoint detail, tracking, rating, dan PDF menerima ID surat, sementara rating/tracking juga menerima NIK 16 digit untuk surat terbaru."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "sanctum": []
    }
  ],
  "tags": [
    {
      "name": "Surat"
    }
  ],
  "paths": {
    "/jenis-surat": {
      "get": {
        "tags": [
          "Surat"
        ],
        "operationId": "jenisSurat",
        "summary": "Daftar jenis surat aktif",
        "responses": {
          "200": {
            "description": "Daftar jenis surat",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Success"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/JenisSurat"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/surat/form-config": {
      "get": {
        "tags": [
          "Surat"
        ],
        "operationId": "formConfig",
        "summary": "Konfigurasi formulir menurut jenis surat",
        "description": "Konfigurasi tersedia untuk suket, skbn, sktm, skdom, skhsl, skusaha, dan skboro. Ini adalah petunjuk tampilan form; validasi server untuk pengajuan hanya mewajibkan jenis_surat, nik, peruntukan, dan pengantar.",
        "parameters": [
          {
            "name": "jenis_surat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "suket",
                "skbn",
                "sktm",
                "skdom",
                "skhsl",
                "skusaha",
                "skboro"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Konfigurasi form",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Success"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/FormConfig"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/surat/history": {
      "get": {
        "tags": [
          "Surat"
        ],
        "operationId": "historySurat",
        "summary": "Riwayat surat menurut NIK",
        "description": "Hasil diurutkan menurut ID menurun dan tidak dipaginasi. jenis_surat atau jenis_surat_id dapat dipakai sebagai filter.",
        "parameters": [
          {
            "$ref": "#/components/parameters/NikRequired"
          },
          {
            "name": "jenis_surat",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Kode atau nama jenis surat."
          },
          {
            "name": "jenis_surat_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Riwayat surat",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Success"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/SuratDetail"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/surat/detail/{id}": {
      "get": {
        "tags": [
          "Surat"
        ],
        "operationId": "detailSurat",
        "summary": "Detail pengajuan surat",
        "parameters": [
          {
            "$ref": "#/components/parameters/SuratId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detail dan tracking surat",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Success"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SuratDetail"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/surat/{id}/rating": {
      "get": {
        "tags": [
          "Surat"
        ],
        "operationId": "getRatingSurat",
        "summary": "Lihat rating surat",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdOrNik"
          },
          {
            "$ref": "#/components/parameters/NikOptional"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/RatingSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/BusinessError"
          }
        }
      },
      "post": {
        "tags": [
          "Surat"
        ],
        "summary": "Simpan rating surat",
        "description": "rating atau bintang wajib diisi dengan angka 1 sampai 5. Nilai dibulatkan ke satu desimal. Menyimpan rating tidak mengubah status surat.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdOrNik"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RatingInput"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RatingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/RatingSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Surat"
        ],
        "summary": "Simpan rating surat",
        "description": "rating atau bintang wajib diisi dengan angka 1 sampai 5. Nilai dibulatkan ke satu desimal. Menyimpan rating tidak mengubah status surat.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdOrNik"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RatingInput"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RatingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/RatingSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/surat/{id}/tracking": {
      "get": {
        "tags": [
          "Surat"
        ],
        "operationId": "trackingSurat",
        "summary": "Tracking surat",
        "description": "NIK 16 digit mengambil surat terbaru berdasarkan updated_at lalu ID. Status Ditolak menyebabkan progress_percent 100.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdOrNik"
          }
        ],
        "responses": {
          "200": {
            "description": "Timeline surat",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Success"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Tracking"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/surat/{id}/pdf-url": {
      "get": {
        "tags": [
          "Surat"
        ],
        "operationId": "pdfUrlSurat",
        "summary": "Dapatkan URL PDF surat",
        "parameters": [
          {
            "$ref": "#/components/parameters/SuratId"
          }
        ],
        "responses": {
          "200": {
            "description": "URL PDF tersedia",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Success"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PdfInfo"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/surat/{id}/download-pdf": {
      "get": {
        "tags": [
          "Surat"
        ],
        "operationId": "downloadPdfSurat",
        "summary": "Buka PDF surat",
        "description": "Mengirim berkas PDF secara inline dengan Content-Disposition inline.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SuratId"
          }
        ],
        "responses": {
          "200": {
            "description": "Konten PDF",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/surat/store": {
      "post": {
        "tags": [
          "Surat"
        ],
        "operationId": "storeSurat",
        "summary": "Ajukan surat baru",
        "description": "Jenis surat harus ada dan aktif di master jenis surat. Mengirim salah satu dari pengajuan_id, id_pengajuan, surat_pengajuan_id, id_surat, atau surat_id akan mengalihkan operasi ini ke revisi surat ditolak; dalam mode tersebut pengantar opsional dan respons 200.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SuratSubmission"
                  },
                  {
                    "$ref": "#/components/schemas/SuratStoreRevision"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuratSuccess"
          },
          "201": {
            "$ref": "#/components/responses/SuratSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/surat/{id}/revisi": {
      "post": {
        "tags": [
          "Surat"
        ],
        "summary": "Perbaiki surat yang ditolak",
        "description": "Alias revisi/perbaiki menjalankan handler yang sama. Surat harus memiliki penanda penolakan. NIK dan jenis surat, bila diberikan, harus sesuai surat lama. Pengantar baru opsional.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SuratId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/SuratRevision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuratSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Surat"
        ],
        "summary": "Perbaiki surat yang ditolak",
        "description": "Alias revisi/perbaiki menjalankan handler yang sama. Surat harus memiliki penanda penolakan. NIK dan jenis surat, bila diberikan, harus sesuai surat lama. Pengantar baru opsional.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SuratId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/SuratRevision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuratSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/surat/{id}/perbaiki": {
      "post": {
        "tags": [
          "Surat"
        ],
        "summary": "Perbaiki surat yang ditolak",
        "description": "Alias revisi/perbaiki menjalankan handler yang sama. Surat harus memiliki penanda penolakan. NIK dan jenis surat, bila diberikan, harus sesuai surat lama. Pengantar baru opsional.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SuratId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/SuratRevision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuratSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Surat"
        ],
        "summary": "Perbaiki surat yang ditolak",
        "description": "Alias revisi/perbaiki menjalankan handler yang sama. Surat harus memiliki penanda penolakan. NIK dan jenis surat, bila diberikan, harus sesuai surat lama. Pengantar baru opsional.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SuratId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/SuratRevision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuratSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sanctum": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum token"
      }
    },
    "parameters": {
      "SuratId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "ID pengajuan surat."
      },
      "IdOrNik": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "ID pengajuan atau NIK 16 digit untuk surat terbaru."
      },
      "NikRequired": {
        "name": "nik",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{16}$"
        }
      },
      "NikOptional": {
        "name": "nik",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{16}$"
        },
        "description": "Jika diisi, harus sama dengan NIK pada surat."
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "Token Sanctum tidak ada atau tidak valid."
      },
      "NotFound": {
        "description": "Data atau jenis surat tidak ditemukan.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "message": "Pengajuan surat tidak ditemukan."
            }
          }
        }
      },
      "BusinessError": {
        "description": "NIK atau kondisi surat tidak sesuai.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validasi Laravel atau aturan bisnis gagal.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/LaravelValidationError"
                },
                {
                  "$ref": "#/components/schemas/Error"
                }
              ]
            },
            "example": {
              "message": "The nik field must be 16 digits.",
              "errors": {
                "nik": [
                  "The nik field must be 16 digits."
                ]
              }
            }
          }
        }
      },
      "ServerError": {
        "description": "Penyimpanan atau pemrosesan gagal.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "SuratSuccess": {
        "description": "Pengajuan atau revisi berhasil.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Success"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Surat"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "RatingSuccess": {
        "description": "Data penilaian surat.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Success"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Rating"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "Success": {
        "type": "object",
        "required": [
          "status",
          "message",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "LaravelValidationError": {
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "JenisSurat": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nama": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "jenis": {
            "type": "string"
          },
          "kode": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "assets": {
            "type": "string",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "persyaratan": {
            "nullable": true
          },
          "is_active": {
            "type": "integer",
            "enum": [
              1
            ]
          }
        }
      },
      "FormConfig": {
        "type": "object",
        "properties": {
          "jenis_surat": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormField"
            }
          }
        }
      },
      "FormField": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "radio",
              "select",
              "date",
              "number",
              "file"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
